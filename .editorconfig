root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml,json,cff}]
indent_style = space
indent_size = 2

[*.{html,css,js,ts,svg}]
indent_style = space
indent_size = 2

[*.ps1]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab
